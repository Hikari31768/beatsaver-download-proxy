{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.beatsaver.com/:path*"
    },
    {
      "source": "/cdn/:path*",
      "destination": "https://cdn.beatsaver.com/:path*"
    },
    {
      "source": "/r2/:path*",
      "destination": "https://r2cdn.beatsaver.com/:path*"
    },
    {
      "source": "/:path*",
      "destination": "https://r2cdn.beatsaver.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
